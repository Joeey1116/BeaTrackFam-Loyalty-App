{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.beatrackfaminc.rewards",
      "permissions": [],
      "versionCode": 2,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "buildNumber": "7",
      "bundleIdentifier": "com.beatrackfaminc.rewards",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "BeaTrackFam Rewards sends you alerts about new rewards, points milestones, and drops.",
        "UIDesignRequiresCompatibility": false
      },
      "supportsTablet": true
    },
    "name": "BeaTrackFam Rewards",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#000000",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to personalize your BeaTrackFam Rewards experience. We run no ads and no third-party trackers \u2014 it stays off unless you turn it on."
        }
      ],
      "./plugins/with-privacy-manifest"
    ],
    "scheme": "beatrackfamrewards",
    "slug": "beatrackfam-rewards",
    "userInterfaceStyle": "dark",
    "version": "0.1",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}